# EditorConfig: https://EditorConfig.org
# Shared editor defaults so contributors do not fight over whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
# PEP 8 and the configured ruff/black line length.
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not strip them.
trim_trailing_whitespace = false

[Makefile]
# Recipes require real tab characters.
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_size = 2
