# =============================================================================
# alberto-research -- environment template
#
# Copy to `.env` for local runs:  cp .env.example .env
# `.env` is gitignored; this template is the only env file in version control.
#
# NO SECRETS ARE COMMITTED HERE. Every credential below is left empty on
# purpose. Values are read from the process environment at runtime -- either
# exported by your shell, injected by the orchestrator (OpenClaw), supplied by
# your container/secret manager, or loaded from an untracked `.env`.
#
# Anything left unset falls back to the default documented in each comment.
# =============================================================================

# -----------------------------------------------------------------------------
# Required for real runs
# -----------------------------------------------------------------------------
# Path to the SQLite database holding runs, papers, digests and feedback.
# Created automatically (with migrations) if it does not exist.
# Example: /var/lib/alberto/alberto.db
ALBERTO_DB=

# Root directory for operational state: downloaded full text, rendered
# newsletters, logs and transient caches. Must be writable by the process user.
# Example: /var/lib/alberto
ALBERTO_HOME=

# -----------------------------------------------------------------------------
# Behaviour
# -----------------------------------------------------------------------------
# Logging verbosity. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# User-Agent sent with outbound HTTP requests to scholarly APIs. Some providers
# (Crossref, Semantic Scholar) rate-limit or block unidentified clients, so set
# a contactable identifier in production. Example: alberto-research/0.1 (mailto:you@example.org)
ALBERTO_USER_AGENT=

# Upper bound, in bytes, on a single full-text download. Guards against
# pathological or hostile PDFs exhausting memory/disk. Unset uses the built-in
# default.
ALBERTO_MAX_FULLTEXT_BYTES=

# Path to the OpenClaw CLI used to delegate LLM work. Defaults to `openclaw`
# resolved on PATH, so leave empty unless you need a specific binary or a
# non-PATH install location. Example: /usr/local/bin/openclaw
ALBERTO_OPENCLAW_BIN=

# -----------------------------------------------------------------------------
# Zotero (library sync)
# -----------------------------------------------------------------------------
# Private API key from https://www.zotero.org/settings/keys. Treat as a
# credential; never commit or share it. Not required if sync is disabled.
ZOTERO_API_KEY=

# Zotero library kind: `user` for a personal library, `group` for a group.
ZOTERO_LIBRARY_TYPE=user

# Numeric Zotero library ID (your userID, or the group ID when
# ZOTERO_LIBRARY_TYPE=group). Not a secret, but environment-specific.
ZOTERO_LIBRARY_ID=

# -----------------------------------------------------------------------------
# Notion (digest mirroring)
# -----------------------------------------------------------------------------
# Internal integration token (`ntn_...`) from
# https://www.notion.so/my-integrations. Must be shared with the target
# database/page, otherwise the API returns 404. Leave empty to disable Notion.
NOTION_API_KEY=

# ID of the Notion database that receives digest pages.
NOTION_DATABASE_ID=

# ID of the Notion data source backing that database (newer Notion API
# versions address data sources directly).
NOTION_DATA_SOURCE_ID=

# Enable or disable Notion delivery. Accepts true/false (also 1/0, yes/no).
# Keep false until the two IDs above are known-good.
ALBERTO_NOTION_ENABLED=

# -----------------------------------------------------------------------------
# Email (newsletter delivery)
# -----------------------------------------------------------------------------
# Transport used to send newsletters. Currently `smtp`; leave empty to disable
# email delivery entirely.
ALBERTO_EMAIL_PROVIDER=

# SMTP server hostname. Example: smtp.example.org
SMTP_HOST=

# SMTP port: 587 for STARTTLS submission, 465 for implicit TLS.
SMTP_PORT=587

# SMTP authentication username. Often the full email address of the sender.
SMTP_USERNAME=

# SMTP password or app-specific token. Use an app password rather than your
# primary account password; treat it as a credential.
SMTP_PASSWORD=

# From header on outgoing newsletters. Example: Alberto Digest <digest@example.org>
SMTP_FROM=

# Recipient address (or comma-separated list) for the newsletter.
SMTP_TO=

# -----------------------------------------------------------------------------
# Provider keys
# -----------------------------------------------------------------------------
# Semantic Scholar API key, which raises the anonymous rate limit substantially.
# Request one at https://www.semanticscholar.org/product/api. Optional: without
# it requests are throttled but still work.
SEMANTIC_SCHOLAR_API_KEY=
